[submodule "src/f1tenth_system"]
    path = src/f1tenth_system
    url = https://github.com/BalaKolanu/f1tenth_system.git
    branch = main
[submodule "src/udp_msgs"]
    path = src/udp_msgs
    url = https://github.com/flynneva/udp_msgs.git
    branch = main
[submodule "src/particle_filter"]
    path = src/particle_filter
    url = https://github.com/f1tenth/particle_filter.git
    branch = humble-devel
[submodule "src/f1tenth_controllers"]
    path = src/f1tenth_controllers
    url = https://github.com/BalaKolanu/mpcc_sampler.git
    branch = f1tenth-system-port
[submodule "src/transport_drivers"]
    path = src/transport_drivers
    url = https://github.com/ros-drivers/transport_drivers.git
    branch = main
